package com.luminar;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

public class PreparedStatementCrudOne {

	public static void main(String[] args) {

		try {
			Class.forName("com.mysql.cj.jdbc.Driver");
			Connection conn=DriverManager.getConnection("jdbc:mysql://localhost:3306/luminar_java","root","mysql");
		PreparedStatement pstmt=conn.prepareStatement("select * from doctors");
		ResultSet rs=pstmt.executeQuery();
		while(rs.next()) {
			System.out.println(rs.getInt(1)+" \t"+rs.getString(2)+"\t"+rs.getFloat(3));
		}
		PreparedStatement pst=conn.prepareStatement("insert into "
		+"doctors(doctor_name,doctor_salary)"
				+ "values('benny',56767)");
		pst.executeUpdate();
		}catch(Exception ex) {
			ex.printStackTrace();
		}
	}

}
